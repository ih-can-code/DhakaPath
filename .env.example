# Copy to .env. Everything is optional: without a key the app uses its built-in Banglish parser.
# Pick ONE free provider.

# Google AI Studio (free tier): https://aistudio.google.com/apikey  (also enables signboard photo reading)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Groq Cloud (free tier): https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama (no key): install Ollama, run `ollama pull llama3.2`, then set:
# OLLAMA_MODEL=llama3.2
# OLLAMA_URL=http://localhost:11434

PORT=5177
ADMIN_PIN=dhaka
